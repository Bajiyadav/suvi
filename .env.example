# Environment Configuration for FraudTrace AI (Team SUVI)
APP_ENV=development
DEBUG=True
PORT=8000
FRONTEND_PORT=3000

# Backend Service
API_V1_PREFIX=/api/v1
PROJECT_NAME="FraudTrace AI"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Connection (Default SQLite for deterministic local demo mode)
DATABASE_URL="sqlite:///./fraudtrace.db"

# Analytics & Scoring Parameters (Configurable weights)
WEIGHT_RAPID_TRANSFER=20
WEIGHT_PASS_THROUGH=20
WEIGHT_MULTI_HOP=20
WEIGHT_BASELINE_DEVIATION=15
WEIGHT_STRUCTURING=10
WEIGHT_COMPLAINTS=15

# Synthetic Data Mode
SYNTHETIC_DATA_FLAG=true
